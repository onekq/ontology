@prefix cairn:  <https://onekq.github.io/ontology/verticals/manufacturing/ontology#> .
@prefix iof:    <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# --- Domain classes not covered by IOF Core / PROV-O / SKOS -----------------

cairn:Product a owl:Class ; rdfs:label "Product" .
cairn:PurchasedKit a owl:Class ;
    rdfs:label "Purchased Kit" ;
    rdfs:comment "Procurement's 'assembly' meaning - a kitted, purchasable unit. Not covered by IOF Core's structural Assembly class." .
cairn:MotorControlUnit a owl:Class ; rdfs:subClassOf iof:MaterialArtifact ;
    rdfs:label "Motor Control Unit" ;
    skos:altLabel "Controller Board Assembly" .
cairn:MotorHousing a owl:Class ; rdfs:subClassOf iof:MaterialArtifact .
cairn:ShippingContainer a owl:Class ; rdfs:subClassOf iof:MaterialArtifact .
cairn:alternativeTo a owl:ObjectProperty ;
    rdfs:comment "Domain-specific: no clean fit in IOF Core, PROV-O, or SKOS for FST-004 vs FST-004-2." .
cairn:mayCorrespondTo a owl:ObjectProperty ;
    rdfs:domain iof:Assembly ; rdfs:range cairn:PurchasedKit ;
    rdfs:comment "Domain-specific, optional: an Assembly (structural, IOF Core) may or may not also be a PurchasedKit (commercial). No current Cairn Drivetrain part instantiates this - see comment on STA-200 below." .
cairn:rotorInstallMinutes a owl:DatatypeProperty ; rdfs:domain iof:PlanSpecification ; rdfs:range xsd:decimal .
cairn:housingAssemblyMinutes a owl:DatatypeProperty ; rdfs:domain iof:PlanSpecification ; rdfs:range xsd:decimal .

# --- Conflict 1: MTR-100R -----------------------------------------------------

cairn:MTR-100 a cairn:Product .
cairn:MTR-100R a cairn:Product ;
    prov:wasDerivedFrom cairn:MTR-100 .

# --- Conflict 2: ROT-320 identifier reuse across revisions -------------------

cairn:ROT-320-RevB a iof:Identifier ;
    iof:denotes cairn:ROT-320-RevB-Part .
cairn:ROT-320-RevB-Part a iof:MaterialComponent ;
    rdfs:label "Neodymium Magnet N38 (6x)" .

cairn:ROT-320-RevC a iof:Identifier ;
    iof:denotes cairn:ROT-320-RevC-Part ;
    prov:wasRevisionOf cairn:ROT-320-RevB .
cairn:ROT-320-RevC-Part a iof:MaterialComponent ;
    rdfs:label "Neodymium Magnet N42 (8x)" .

cairn:MTR-100
    iof:hasComponentPartAtSomeTime cairn:ROT-320-RevC-Part .
cairn:MTR-100R
    iof:hasComponentPartAtSomeTime cairn:ROT-320-RevB-Part .

# --- Conflict 3: FST-004 vendor cross-references ------------------------------

cairn:FST-004 a iof:MaterialComponent ;
    rdfs:label "M4x12 SHCS" ;
    qudt:hasQuantity [ qudt:value 12 ; qudt:unit unit:MilliM ] .

cairn:Meridian-MF-SC-0412Z skos:exactMatch cairn:FST-004 .
cairn:MeridianFasteners a iof:Manufacturer, iof:Supplier ;
    rdfs:label "Meridian Fasteners" .

cairn:TriStar-TS-4120
    skos:closeMatch cairn:FST-004 ;
    qudt:hasQuantity [ qudt:value 12.7 ; qudt:unit unit:MilliM ] . # 0.5in converted - does not equal FST-004's 12mm
cairn:TriStarHardware a iof:Supplier ;
    rdfs:label "Tri-Star Hardware" .
    # No iof:Manufacturer role asserted - genuinely unknown, not assumed.

cairn:ValueBolt-VB-M412SH a iof:MaterialComponent ;
    rdfs:label "M4x12 Button Head Cap Screw" .
    # No skos:closeMatch or skos:exactMatch to FST-004 - confirmed wrong head type, not merely unverified.
cairn:ValueBoltSupply a iof:Supplier ;
    rdfs:label "Value Bolt Supply" .

cairn:FST-004 cairn:alternativeTo cairn:FST-004-2 .
cairn:FST-004-2 a iof:MaterialComponent ;
    rdfs:label "M4x12 SHCS, zinc-nickel coated" .

# --- Conflict 5: Assembly split -----------------------------------------------

cairn:STA-200 a iof:Assembly ;
    rdfs:comment "Built in-house; has component parts at all times per IOF Core's definition. Does NOT get cairn:mayCorrespondTo to any PurchasedKit - it is explicitly not purchased as a kit. No part in the current materials genuinely is a PurchasedKit; the class and mayCorrespondTo are declared for completeness, not force-instantiated against a bad fit." .

# --- Conflicts 6 & 7: Controller and Housing name collisions -----------------

cairn:CTL-400 a cairn:MotorControlUnit ;
    skos:altLabel "Controller Board Assembly" ;
    rdfs:comment "ERP still uses the alias label; engineering drawings use MotorControlUnit per ECN-124." .

cairn:HSG-500 a cairn:MotorHousing .

# cairn:ShippingContainer is declared as a class (Conflict 7) but no source
# material actually describes a concrete shipping crate as a trackable part
# with its own identifier - so unlike MotorHousing, it has no instance here.
# Declared for completeness, not force-instantiated against nonexistent data.

# --- Conflict 8: requirement satisfaction re-verification --------------------

cairn:REQ-002 a iof:RequirementSpecification ;
    rdfs:comment "Rotor shall deliver minimum 45 Nm continuous torque at rated RPM." ;
    iof:requirementSatisfiedBy cairn:ROT-320-RevC-Part .
    # Deliberately NOT asserted as satisfied by ROT-320-RevB-Part / MTR-100R - see changelog.

# --- Conflict 9: Station 2 QC checkpoint doesn't verify rotor identity -------

cairn:Station2-RotorInstall a iof:AssemblyProcess ;
    rdfs:label "Station 2 - Rotor Install" .

cairn:Station2-MagnetPresenceCheck a iof:MeasurementProcess ;
    iof:hasProcessCharacteristic cairn:MagnetPresence ;
    rdfs:comment "Verifies magnets are present. Does NOT verify iof:Identifier (ROT-320-RevB vs RevC) or magnet count/grade - a real, queryable gap, not an assumption." .
cairn:MagnetPresence a iof:ProcessCharacteristic ;
    rdfs:label "magnet presence (not identifier, not count)" .

cairn:Station2-RotorInstall iof:containsOccurrenceOf cairn:Station2-MagnetPresenceCheck .

# --- Conflict 10: two disagreeing cycle-time plans ---------------------------

cairn:WI-MTR100-01-CycleTimes a iof:PlanSpecification ;
    rdfs:label "WI-MTR100-01 cycle times (Production Engineering)" ;
    cairn:rotorInstallMinutes 4.5 ;
    cairn:housingAssemblyMinutes 5.5 .

cairn:CapacityTable-2024-08 a iof:PlanSpecification ;
    rdfs:label "Station Capacity Assumptions, 2024-08 (Production Planning)" ;
    cairn:rotorInstallMinutes 3.5 ;
    cairn:housingAssemblyMinutes 5.0 .

# Deliberately two instances, not one reconciled number - see changelog.
